#!/usr/bin/env bash
# glassy - start/stop the desktop widgets (left panel, right panel, clock)
APP="${GLASSY_HOME:-$HOME/.local/share/glassy}"
LOG="$HOME/.cache/glassy/glassy.log"   # errors from the widgets go here
mkdir -p "$(dirname "$LOG")"

is_running() { pgrep -f "$1" >/dev/null 2>&1; }

start_one() {  # start_one <match-pattern> <command...>
  local pat="$1"; shift
  is_running "$pat" || nohup "$@" >>"$LOG" 2>&1 &
}

start() {
  if [ -z "${DISPLAY:-}" ]; then
    echo "glassy: no graphical display found (DISPLAY is empty)." >&2
    exit 1
  fi
  start_one "$APP/left_widget.py"  python3 "$APP/left_widget.py"
  start_one "$APP/right_widget.py" python3 "$APP/right_widget.py"
  start_one "conky .*glassy/conkyrc" python3 "$APP/start_clock.py"
}

stop() {
  pkill -f "$APP/left_widget.py"  2>/dev/null
  pkill -f "$APP/right_widget.py" 2>/dev/null
  pkill -f "conky .*glassy/conkyrc" 2>/dev/null
  return 0
}

case "${1:-}" in
  start)   start ;;
  stop)    stop ;;
  restart) stop; sleep 1; start ;;
  boot)    sleep "${2:-5}"; start ;;   # used by autostart: wait for the desktop to load
  status)
    for n in left_widget.py right_widget.py; do
      if is_running "$APP/$n"; then echo "$n: running"; else echo "$n: stopped"; fi
    done
    if is_running "conky .*glassy/conkyrc"; then echo "clock: running"; else echo "clock: stopped"; fi ;;
  *) echo "Usage: glassy {start|stop|restart|status}"; exit 1 ;;
esac
